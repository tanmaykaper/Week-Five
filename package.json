{
  "name": "week-five",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Week Five: the map and the mirror for the first 24 weeks of hair regrowth treatment. An independent concept for the Mosaic Fellowship Builder Challenge.",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build && node scripts/build-sw.mjs",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/week-five pnpm build",
    "serve": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screens": "playwright test tests/e2e/screens.spec.ts",
    "copy-check": "node scripts/check-copy.mjs",
    "icons": "node scripts/make-icons.mjs",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm copy-check && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.15.0",
    "idb": "8.0.4",
    "motion": "14.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
